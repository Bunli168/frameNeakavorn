# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Frame image file (relative to project root)
FRAME_PATH=កឋិន.png

# Seconds to wait before processing an album
ALBUM_TIMEOUT=2.0

# Output JPEG quality (1-95)
JPEG_QUALITY=90

# Local HTTP port (Render sets PORT automatically)
PORT=8080
